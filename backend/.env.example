# Copia este archivo como .env y completa los valores

# Base de datos:
# SQLite local:
DATABASE_URL=sqlite+aiosqlite:///./veterinaria.db
# PostgreSQL (Supabase Session Pooler):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# JWT
SECRET_KEY=cambia_esto_por_una_clave_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Poner true solo en desarrollo local
DEBUG=false
